            "type": "number",
            "minimum": 0.5,
            "maximum": 8,
            "default": 1.5
          },
          "allow_break": {
            "type": "boolean",
            "default": false
          },
          "allow_place": {
            "type": "boolean",
            "default": false
          },
          "max_blocks_broken": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256,
            "default": 0
