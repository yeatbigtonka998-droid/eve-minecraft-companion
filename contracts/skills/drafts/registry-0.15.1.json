    {
      "name": "build_schematic",
      "version": 1,
      "summary": "Build the design folder <project_id>/v<version> (design.json + build_order.json [+ scaffold.json]) whose hash equals design_hash: scaffold first, role order, normal-reach placement with place_block/mine_block/use_item/walk_to, cells already right are skipped (resume), then compare every cell and fix mismatches; scaffold removed last. origin (the approved site) overrides design.json's origin. States place_block v1 cannot produce are reported under manual. Fails no_item with the deficit before placing anything when supplies are short.",
      "params": {
        "type": "object",
        "required": [
          "project_id",
          "version",
          "design_hash"
        ],
        "properties": {
