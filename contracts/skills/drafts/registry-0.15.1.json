{
  "registry_version": "0.15.1",
  "$defs": {
    "pos": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "block_pos": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer",
          "minimum": -64,
          "maximum": 319
        },
        "z": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "item_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "block_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2304
    },
    "entity_id": {
      "type": "integer",
      "minimum": 0
    }
  },
  "skills": [
    {
      "name": "stop",
      "version": 1,
      "summary": "Cancel the active action and clear inputs. Always accepted.",
      "params": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "effects": [],
      "preconditions": [],
      "timeout_ms": 1000,
      "cancellable": false,
      "evidence": [
        "inputs_cleared",
        "latency_ms"
      ],
      "failure_codes": [],
      "min_mode": "manual"
    },
    {
      "name": "look_at",
      "version": 1,
      "summary": "Turn head to face a position or entity.",
      "params": {
        "type": "object",
        "properties": {
          "pos": {
            "$ref": "#/$defs/pos"
          },
          "entity_id": {
            "$ref": "#/$defs/entity_id"
          }
        },
        "oneOf": [
          {
            "required": [
              "pos"
            ]
          },
          {
            "required": [
              "entity_id"
            ]
          }
        ],
        "additionalProperties": false
      },
      "effects": [],
      "preconditions": [
        "alive",
        "not_stopped"
      ],
      "timeout_ms": 2000,
      "cancellable": true,
      "evidence": [
        "yaw",
        "pitch",
        "angle_error_deg"
      ],
      "failure_codes": [
        "entity_gone",
        "cancelled",
        "timeout"
      ],
      "min_mode": "manual"
    },
    {
