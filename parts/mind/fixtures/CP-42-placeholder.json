{
  "_note": "CP-42 PLACEHOLDER set (orchestrator, 2026-10-21): written by the mind chat to build and dry-run the harness while Hunter's own twenty commands (P18) are owed. NOT qualifying: Hunter's set replaces `clear` (same shape) and is the qualifying set. Judged on the outcome in the records (dispatched action + params, question asked, control state, approvals), never on wording. O25a stop rules apply; no model decides a refusal or a stop.",
  "clear": [
    {"texts": ["eve, go to 8 64 -20", "walk over to 8 64 -20 please", "can you head to 8 64 -20"], "expect": {"do": "walk_to", "params": {"pos": {"x": 8, "y": 64, "z": -20}}}},
    {"texts": ["look at 6 65 2", "face 6 65 2", "turn and look toward 6 65 2"], "expect": {"do": "look_at", "params": {"pos": {"x": 6, "y": 65, "z": 2}}}},
    {"texts": ["go home", "head back home", "return to base"], "expect": {"control": "home"}},
    {"texts": ["select slot 2", "use your second hotbar slot", "switch to hotbar slot 2"], "expect": {"do": "select_hotbar", "params": {"slot": 1}}},
    {"texts": ["say good night everyone", "tell everyone good night", "post 'good night everyone' in chat"], "expect": {"do": "chat_say", "params": {"text": "good night everyone"}}},
    {"texts": ["sneak", "start crouching", "crouch down"], "expect": {"do": "sneak", "params": {"on": true}}},
    {"texts": ["jump", "hop once", "do a jump"], "expect": {"do": "jump", "params": {}}},
    {"texts": ["break the block at 2 63 -4", "mine 2 63 -4", "dig out the block at 2 63 -4"], "expect": {"do": "mine_block", "params": {"pos": {"x": 2, "y": 63, "z": -4}}}},
    {"texts": ["place oak planks at 3 64 3", "put an oak plank block at 3 64 3", "build an oak planks block at 3 64 3"], "expect": {"do": "place_block", "params": {"pos": {"x": 3, "y": 64, "z": 3}, "item": "minecraft:oak_planks"}}},
    {"texts": ["open the chest at 9 64 9", "open up the container at 9 64 9", "check the chest at 9 64 9"], "expect": {"do": "open_container", "params": {"pos": {"x": 9, "y": 64, "z": 9}}}},
    {"texts": ["walk to x 30 y 66 z -10", "go to coordinates 30, 66, -10", "move over to 30 66 -10"], "expect": {"do": "walk_to", "params": {"pos": {"x": 30, "y": 66, "z": -10}}}},
    {"texts": ["stand up", "quit sneaking", "uncrouch"], "expect": {"do": "sneak", "params": {"on": false}}},
    {"texts": ["say I'm on my way", "type 'I'm on my way' in chat", "send 'I'm on my way' to chat"], "expect": {"do": "chat_say", "params": {"text": "I'm on my way"}}},
    {"texts": ["pick slot 7", "switch to the seventh slot", "select your 7th hotbar slot"], "expect": {"do": "select_hotbar", "params": {"slot": 6}}},
    {"texts": ["look at 0 70 -5", "look toward 0 70 -5", "aim at 0 70 -5"], "expect": {"do": "look_at", "params": {"pos": {"x": 0, "y": 70, "z": -5}}}},
    {"texts": ["mine the block at -3 62 1", "break -3 62 1", "dig the block at -3 62 1"], "expect": {"do": "mine_block", "params": {"pos": {"x": -3, "y": 62, "z": 1}}}},
    {"texts": ["place cobblestone at -1 64 2", "put cobblestone at -1 64 2", "set a cobblestone block at -1 64 2"], "expect": {"do": "place_block", "params": {"pos": {"x": -1, "y": 64, "z": 2}, "item": "minecraft:cobblestone"}}},
    {"texts": ["walk to 14 64 6", "go over to 14 64 6", "get yourself to 14 64 6"], "expect": {"do": "walk_to", "params": {"pos": {"x": 14, "y": 64, "z": 6}}}},
    {"texts": ["switch to supervised mode", "go into supervised mode", "set your mode to supervised"], "expect": {"control": "mode", "mode": "supervised"}},
    {"texts": ["you can carry on", "ok, resume", "go ahead and continue"], "setup": "stopped", "expect": {"control": "resume"}}
  ],
  "ambiguous": [
    {"text": "go over there", "expect": {"question": true}},
    {"text": "mine that one", "expect": {"question": true}},
    {"text": "place something here", "expect": {"question": true}},
    {"text": "walk to 12 64", "expect": {"question": true}},
    {"text": "open it", "expect": {"question": true}}
