    {"text": "STOP going to 7 64 7", "setup": "walking", "expect": {"control": "stop"}},
    {"text": "don't stop, keep walking", "setup": "walking", "expect": {"not_stopped": true}}
  ],
  "cancelled": [
    {"texts": ["walk to 20 64 20", "never mind, cancel that"], "expect": {"cancelled": true}},
