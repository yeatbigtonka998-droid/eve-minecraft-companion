inn = Build(style="medieval", seed=7)
inn.foundation(w=9, d=14, h=1, block="cobblestone")
inn.walls(h=4, storeys=2, frame="oak_log", fill="oak_planks", frame_every=4)
inn.floor(block="oak_planks")
inn.door(side="south", at="center")
inn.windows(side="south", count=2, w=2, h=2, storey=0)
inn.windows(side="south", count=2, w=2, h=2, storey=1)
inn.windows(side="north", count=2, w=2, h=2, storey=0)
inn.windows(side="north", count=2, w=2, h=2, storey=1)
inn.windows(side="east", count=1, w=2, h=2, storey=0)
inn.windows(side="west", count=1, w=2, h=2, storey=0)
inn.stairs(storey=0, side="north", at=2)
inn.room("living", furnish=True, storey=0)
inn.room("kitchen", furnish=True, storey=0)
inn.room("bedroom", furnish=True, storey=1)
inn.room("bedroom", furnish=True, storey=1)
inn.roof("gable", ridge="east_west", overhang=1, block="oak")
inn.chimney(side="west", block="cobblestone")
inn.porch(side="south", depth=2, block="oak_planks", roof="flat", width=7)
inn.dormer(side="south", at="center")
inn.detail(rule="style", on=True)
