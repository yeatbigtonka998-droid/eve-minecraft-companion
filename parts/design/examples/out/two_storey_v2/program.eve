# Two-storey family house (CP-57): living + kitchen downstairs, two bedrooms upstairs, straight stairs.
house = Build(style="cozy_cabin", seed=7)
house.foundation(w=15, d=11, h=1)
house.walls(h=4, storeys=2)
house.floor()
house.door(side="south", at="center")
house.windows(side="south", count=2, w=2, h=2, storey=0)
house.windows(side="south", count=3, w=2, h=2, storey=1)
house.windows(side="north", count=2, w=2, h=2, storey=0)
house.windows(side="north", count=2, w=2, h=2, storey=1)
house.windows(side="east", count=1, w=2, h=2, storey=1)
house.windows(side="west", count=1, w=2, h=2, storey=1)
house.stairs(storey=0, side="north", at=2)
house.room("living", storey=0)
house.room("kitchen", storey=0)
house.room("bedroom", storey=1)
house.room("bedroom", storey=1)
house.roof("gable", ridge="east_west", overhang=1)
house.chimney(side="west")
