# Timber-framed two-storey house in the medieval style card (drafted from measured references, CP-58).
house = Build(style="medieval", seed=21)
house.foundation(w=11, d=9, h=1)
house.walls(h=4, storeys=2, frame_every=3)
house.floor()
house.door(side="south", at="center")
house.windows(side="south", count=2, w=1, h=2, storey=0)
house.windows(side="south", count=2, w=1, h=2, storey=1)
house.windows(side="north", count=2, w=1, h=2, storey=1)
house.windows(side="east", count=1, w=1, h=2, storey=0)
house.stairs(storey=0, side="north", at=2)
house.room("living")
house.room("bedroom", storey=1)
house.roof("gable", ridge="east_west", overhang=1)
house.chimney(side="west")
house.detail("style")
