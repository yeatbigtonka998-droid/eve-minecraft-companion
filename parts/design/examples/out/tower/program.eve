# Watchtower (CP-57): six storeys, the wall steps in by one block every two storeys, stairs on every floor.
tower = Build(style="cozy_cabin", seed=5)
tower.foundation(w=13, d=13, h=1, block="stone_bricks")
tower.walls(h=4, storeys=6, setback_every=2, setback=1, frame="stone_bricks", fill="cobblestone")
tower.floor()
tower.door(side="south", at="center")
tower.windows(side="east", count=1, w=1, h=2, storey=1)
tower.windows(side="west", count=1, w=1, h=2, storey=3)
tower.windows(side="north", count=1, w=1, h=2, storey=5)
tower.windows(side="south", count=2, w=1, h=2, storey=5)
tower.stairs(storey=0, side="north", at=2)
tower.stairs(storey=1, side="south", at=2)
tower.stairs(storey=2, side="north", at=2)
tower.stairs(storey=3, side="south", at=1)
tower.stairs(storey=4, side="north", at=2)
tower.room("storage", storey=0)
tower.room("workshop", storey=2)
tower.room("bedroom", storey=5)
tower.roof("gable", ridge="north_south", overhang=1, block="spruce")
