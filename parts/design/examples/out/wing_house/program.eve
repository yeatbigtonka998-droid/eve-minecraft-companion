# L-shaped house (CP-57): a two-storey main block with a single-storey wing to the south-east.
home = Build(style="cozy_cabin", seed=11)
home.foundation(w=13, d=9, h=1)
home.walls(h=4, storeys=2)
home.floor()
home.door(side="west", at="center")
home.windows(side="north", count=2, w=2, h=2, storey=0)
home.windows(side="north", count=2, w=2, h=2, storey=1)
home.windows(side="south", count=2, w=2, h=2, storey=1)
home.stairs(storey=0, side="north", at=2)
home.wing(name="annex", side="south", length=7, depth=8, at=5)
home.floor(part="annex")
home.windows(side="east", count=2, w=2, h=2, part="annex")
home.windows(side="south", count=1, w=2, h=2, part="annex")
home.room("living")
home.room("workshop", part="annex")
home.room("bedroom", storey=1)
home.roof("gable", ridge="east_west", overhang=1)
home.roof("gable", ridge="north_south", overhang=1, part="annex")
