# Modern asymmetrical home (CP-57): flat roofs at two heights, off-centre door, wide glass, no frame pillars.
villa = Build(style="cozy_cabin", seed=3)
villa.foundation(w=15, d=9, h=1, block="smooth_stone")
villa.walls(h=4, storeys=2, frame="white_concrete", fill="white_concrete", frame_every=0)
villa.floor(block="birch_planks")
villa.door(side="south", at=3, block="birch")
villa.windows(side="south", count=2, w=3, h=2, storey=0)
villa.windows(side="south", count=1, w=9, h=3, sill=0, storey=1)
villa.windows(side="east", count=1, w=5, h=2, storey=1)
villa.windows(side="north", count=2, w=3, h=2, storey=1)
villa.stairs(storey=0, side="north", at=9)
villa.wing(name="studio", side="west", length=7, depth=7, at=0, frame="light_gray_concrete", fill="light_gray_concrete", frame_every=0)
villa.floor(block="birch_planks", part="studio")
villa.windows(side="west", count=1, w=5, h=2, part="studio")
villa.room("living")
villa.room("kitchen")
villa.room("bedroom", storey=1)
villa.room("workshop", part="studio")
villa.roof("flat", overhang=1, block="smooth_stone")
villa.roof("flat", overhang=0, block="smooth_stone", part="studio")
